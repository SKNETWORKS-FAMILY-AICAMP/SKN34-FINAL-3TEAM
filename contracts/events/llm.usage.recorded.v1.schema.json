{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sagomungchi.dev/schemas/events/llm.usage.recorded.v1.schema.json",
  "title": "llm.usage.recorded v1",
  "description": "LLM·모델 요청 1회의 사용량 (봉투 data). 재시도도 요청마다 1건 발행. 생산: ai, scoring / 소비: core → llm_usage. 학생 ID·답변 원문 미포함 (NFR-PRF-02), 비용은 core가 소비 시 계산. 이벤트 ID·발생 시각은 봉투 id·time 사용",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "service",
    "callType",
    "model",
    "promptVersion",
    "inputTokens",
    "outputTokens",
    "latencyMs",
    "success",
    "errorCode"
  ],
  "properties": {
    "service": {
      "description": "발행 서비스",
      "enum": ["ai", "scoring"]
    },
    "callType": {
      "description": "호출 종류",
      "enum": ["JUDGMENT", "FOLLOWUP", "ANALYSIS", "REPORT_NARRATIVE", "M2", "M1", "SPEECH"]
    },
    "model": {
      "description": "실제 호출한 모델 ID",
      "type": "string",
      "minLength": 1
    },
    "promptVersion": {
      "description": "프롬프트 버전 (예: judge@1). 프롬프트 없는 호출(M1·M2)은 null",
      "type": ["string", "null"]
    },
    "inputTokens": {
      "description": "입력 토큰 수. 제공자가 사용량을 주지 않거나 호출 전 실패하면 null",
      "type": ["integer", "null"],
      "minimum": 0
    },
    "outputTokens": {
      "description": "출력 토큰 수. 제공자가 사용량을 주지 않거나 호출 전 실패하면 null",
      "type": ["integer", "null"],
      "minimum": 0
    },
    "latencyMs": {
      "description": "요청 1회의 시간(ms)",
      "type": "integer",
      "minimum": 0
    },
    "success": {
      "type": "boolean"
    },
    "errorCode": {
      "description": "실패 사유 (예: AI_UNAVAILABLE, LLM_TIMEOUT). 성공이면 null",
      "type": ["string", "null"]
    }
  }
}
