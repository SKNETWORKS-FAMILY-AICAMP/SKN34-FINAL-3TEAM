{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "report.completed.v1.schema.json",
  "title": "report.completed v1 data",
  "description": "report-service → events.topic → core; subject=studentId; 종료 상태는 되돌리지 않는다.",
  "type": "object",
  "required": [
    "jobId",
    "studentId",
    "reportId"
  ],
  "properties": {
    "jobId": {
      "type": "string",
      "format": "uuid"
    },
    "studentId": {
      "type": "string",
      "format": "uuid"
    },
    "reportId": {
      "type": "string",
      "format": "uuid"
    },
    "noRecord": {
      "type": "boolean",
      "description": "#846 선택 필드. 리포트가 기록 없음(NO_RECORD)이면 true. 생략 = false이며 report는 true일 때만 넣는다."
    }
  },
  "additionalProperties": false
}
