{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model.version.activated.v1.schema.json",
  "title": "model.version.activated v1 data",
  "description": "core Outbox → events.topic; every ai/scoring Pod binds its own exclusive auto-delete queue. Apply only newer revision per kind/name and only listed scopes. Startup snapshot uses identical version fields. No evaluation records or student content.",
  "type": "object",
  "required": [
    "id",
    "kind",
    "name",
    "version",
    "refId",
    "artifactUri",
    "scopes",
    "revision",
    "activatedAt",
    "previousVersionId"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "enum": [
        "RUBRIC",
        "MODEL",
        "PROMPT",
        "GENERATION"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "refId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "artifactUri": {
      "type": [
        "string",
        "null"
      ]
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._:/-]{0,199}$"
      }
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "activatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "previousVersionId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    }
  },
  "additionalProperties": false
}
