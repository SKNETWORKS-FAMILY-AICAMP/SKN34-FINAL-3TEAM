# 실서버 E2E 전용 합성 값 (#246). 실제 키·비밀번호가 아니며 로컬·CI 일회성 스택에만 사용
# 사용: docker compose -p sagomungchi-e2e --env-file infrastructure/stubs/e2e.env -f compose.yaml -f compose.minio.yaml -f compose.e2e.yaml ...
POSTGRES_USER=sagomungchi
POSTGRES_PASSWORD=e2e-synthetic-postgres
CORE_MIGRATE_PASSWORD=e2e-synthetic-core-migrate
CORE_APP_PASSWORD=e2e-synthetic-core-app
LEARNING_MIGRATE_PASSWORD=e2e-synthetic-learning-migrate
LEARNING_APP_PASSWORD=e2e-synthetic-learning-app
REPORT_MIGRATE_PASSWORD=e2e-synthetic-report-migrate
REPORT_APP_PASSWORD=e2e-synthetic-report-app
RABBITMQ_USER=sagomungchi
RABBITMQ_PASSWORD=e2e-synthetic-rabbitmq
MINIO_ROOT_USER=sagomungchi
MINIO_ROOT_PASSWORD=e2e-synthetic-minio
REPORT_S3_BUCKET=sagomungchi-local-reports
INTERNAL_TOKEN=e2e-synthetic-internal-token

# base64("e2e-synthetic-jwt-secret-not-for-production")
AUTH_JWT_SECRET=ZTJlLXN5bnRoZXRpYy1qd3Qtc2VjcmV0LW5vdC1mb3ItcHJvZHVjdGlvbg==
# playwright.e2e.config.ts의 웹 주소와 같아야 함 (콜백·Origin 검사)
AUTH_WEB_ORIGIN=http://127.0.0.1:5272
AUTH_COOKIE_SECURE=false

# google-stub 전용 클라이언트
GOOGLE_CLIENT_ID=e2e-google-client
GOOGLE_CLIENT_SECRET=e2e-google-secret

# 시드(frontend/web/tests/e2e/seed/core.sql)의 무료 상품 id
PAYMENT_FREE_PRODUCT_ID=00000000-0000-4000-8000-0000000e2e01
# toss-stub 전용. core 키 가드(test_sk_) 통과용 접두사만 맞춘 값
TOSS_TEST_SECRET_KEY=test_sk_e2e_stub_only
TOSS_TEST_BILLING_SECRET_KEY=test_sk_e2e_billing_stub_only
TOSS_TEST_MID=e2e_stub_mid
TOSS_TEST_BILLING_MID=e2e_stub_billing_mid
TOSS_TEST_WEBHOOK_SECURITY_KEY=e2e-synthetic-webhook
TOSS_TEST_BILLING_WEBHOOK_SECURITY_KEY=e2e-synthetic-billing-webhook
# base64("e2e-synthetic-billing-aes-key-32"), 32바이트
PAYMENT_BILLING_ENCRYPTION_KEY=ZTJlLXN5bnRoZXRpYy1iaWxsaW5nLWFlcy1rZXktMzI=
