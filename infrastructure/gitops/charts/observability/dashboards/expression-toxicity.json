{
  "uid": "expression-toxicity",
  "title": "표현 분류 판정",
  "description": "learning 답변 표현 분류(tox) 판정 비율. 지표 expression.toxicity.checks(result·model), #984. 모델 교체는 모델별 선이 바뀌는 시점으로 본다",
  "tags": [
    "learning",
    "toxicity"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "editable": false,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "막은 비율 (모델별)",
      "description": "flagged / 검사된 판정(flagged+review+clean). 해당 판정이 0건이면 0으로 표시",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (model) (rate(expression_toxicity_checks_total{result=\"flagged\"}[$__rate_interval])) or 0 * sum by (model) (rate(expression_toxicity_checks_total{result!=\"unchecked\"}[$__rate_interval]))) / sum by (model) (rate(expression_toxicity_checks_total{result!=\"unchecked\"}[$__rate_interval]))",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "경계 구간 비율 (모델별)",
      "description": "review / 검사된 판정. 통과했지만 표현 검토 대기에 오른 비율. 해당 판정이 0건이면 0으로 표시",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (model) (rate(expression_toxicity_checks_total{result=\"review\"}[$__rate_interval])) or 0 * sum by (model) (rate(expression_toxicity_checks_total{result!=\"unchecked\"}[$__rate_interval]))) / sum by (model) (rate(expression_toxicity_checks_total{result!=\"unchecked\"}[$__rate_interval]))",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "검사 안 됨 비율",
      "description": "unchecked / 전체 호출. scoring 시간 초과·장애·서킷 열림·활성 모델 없음·계약 밖 응답으로 검사 없이 통과(fail-open). 해당 판정이 0건이면 0으로 표시",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(expression_toxicity_checks_total{result=\"unchecked\"}[$__rate_interval])) or 0 * sum(rate(expression_toxicity_checks_total[$__rate_interval]))) / sum(rate(expression_toxicity_checks_total[$__rate_interval]))",
          "legendFormat": "unchecked"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "판정 건수 (결과·모델별)",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (result, model) (increase(expression_toxicity_checks_total[$__rate_interval]))",
          "legendFormat": "{{result}} {{model}}"
        }
      ]
    }
  ]
}
