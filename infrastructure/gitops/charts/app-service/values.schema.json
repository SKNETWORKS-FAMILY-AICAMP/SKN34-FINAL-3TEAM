{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "service", "networkPolicy"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "digest": {"type": "string"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "replicaCount": {"type": "integer", "minimum": 0},
    "terminationGracePeriodSeconds": {"type": "integer", "minimum": 0},
    "affinity": {"type": "object"},
    "service": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "port": {"type": "integer", "minimum": 0, "maximum": 65535},
        "targetPort": {"type": "integer", "minimum": 0, "maximum": 65535}
      }
    },
    "hpa": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "minReplicas": {"type": "integer", "minimum": 1},
        "maxReplicas": {"type": "integer", "minimum": 1},
        "cpuUtilization": {"type": "integer", "minimum": 1, "maximum": 100}
      }
    },
    "keda": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "minReplicaCount": {"type": "integer", "minimum": 0},
        "maxReplicaCount": {"type": "integer", "minimum": 1},
        "queues": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "cron": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["timezone", "start", "end"],
            "properties": {
              "timezone": {"type": "string", "minLength": 1},
              "start": {"type": "string", "minLength": 1},
              "end": {"type": "string", "minLength": 1},
              "desiredReplicas": {"type": "integer", "minimum": 1}
            }
          }
        },
        "renderReplicaCount": {"type": "boolean"}
      }
    },
    "nodeSelector": {"type": "object"},
    "tolerations": {"type": "array"},
    "modelDownload": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {
          "type": "object",
          "properties": {
            "repository": {"type": "string"},
            "tag": {"type": "string"},
            "digest": {"type": "string"}
          }
        },
        "mountPath": {"type": "string", "pattern": "^/"},
        "sizeLimit": {"type": "string", "minLength": 1}
      }
    },
    "migration": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "revision": {"type": "string"}
      }
    }
  }
}
