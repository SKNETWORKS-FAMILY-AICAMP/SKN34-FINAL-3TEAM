{
  "replicas": 1,
  "serviceAccount": {
    "create": true,
    "name": "karpenter"
  },
  "settings": {
    "clusterName": "sagomungchi-demo-eks",
    "eksControlPlane": true,
    "interruptionQueue": ""
  },
  "controller": {
    "env": [
      {
        "name": "AWS_REGION",
        "value": "ap-northeast-2"
      }
    ],
    "resources": {
      "requests": {
        "cpu": "200m",
        "memory": "384Mi"
      },
      "limits": {
        "memory": "512Mi"
      }
    }
  },
  "affinity": {
    "nodeAffinity": {
      "requiredDuringSchedulingIgnoredDuringExecution": {
        "nodeSelectorTerms": [
          {
            "matchExpressions": [
              {
                "key": "eks.amazonaws.com/nodegroup",
                "operator": "In",
                "values": [
                  "application"
                ]
              },
              {
                "key": "karpenter.sh/nodepool",
                "operator": "DoesNotExist"
              }
            ]
          }
        ]
      }
    }
  }
}
