{
  "apiVersion": "networking.k8s.io/v1",
  "kind": "NetworkPolicy",
  "metadata": {
    "name": "app-oneoff-db",
    "namespace": "app"
  },
  "spec": {
    "podSelector": {
      "matchExpressions": [
        {
          "key": "app.kubernetes.io/name",
          "operator": "In",
          "values": [
            "rds-bootstrap",
            "demo-db-oneoff"
          ]
        }
      ]
    },
    "policyTypes": [
      "Ingress",
      "Egress"
    ],
    "ingress": [],
    "egress": [
      {
        "to": [
          {
            "namespaceSelector": {
              "matchLabels": {
                "kubernetes.io/metadata.name": "kube-system"
              }
            },
            "podSelector": {
              "matchLabels": {
                "k8s-app": "kube-dns"
              }
            }
          }
        ],
        "ports": [
          {
            "protocol": "UDP",
            "port": 53
          },
          {
            "protocol": "TCP",
            "port": 53
          }
        ]
      },
      {
        "ports": [
          {
            "port": 5432,
            "protocol": "TCP"
          }
        ],
        "to": [
          {
            "ipBlock": {
              "cidr": "10.20.128.0/20"
            }
          },
          {
            "ipBlock": {
              "cidr": "10.20.144.0/20"
            }
          }
        ]
      }
    ]
  }
}
