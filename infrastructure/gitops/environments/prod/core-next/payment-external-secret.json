{
  "apiVersion": "external-secrets.io/v1",
  "kind": "ExternalSecret",
  "metadata": {
    "namespace": "app",
    "name": "payment-credentials"
  },
  "spec": {
    "dataFrom": [
      {
        "extract": {
          "key": "sagomungchi/demo/app/payment"
        }
      }
    ],
    "refreshInterval": "1h",
    "secretStoreRef": {
      "kind": "SecretStore",
      "name": "aws-secrets-manager"
    },
    "target": {
      "creationPolicy": "Owner",
      "deletionPolicy": "Retain",
      "name": "payment-credentials"
    }
  }
}
