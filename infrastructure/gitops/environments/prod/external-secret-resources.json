          "name": "aws-secrets-manager"
        },
        "target": {
          "creationPolicy": "Owner",
          "deletionPolicy": "Retain",
          "name": "rabbitmq-credentials",
          "template": {
            "data": {
              "RABBITMQ_CORE_URL": "amqp://core:{{ .RABBITMQ_CORE_PASSWORD | urlquery | replace \"+\" \"%20\" }}@rabbitmq.platform.svc.cluster.local:5672/",
              "RABBITMQ_LEARNING_URL": "amqp://learning:{{ .RABBITMQ_LEARNING_PASSWORD | urlquery | replace \"+\" \"%20\" }}@rabbitmq.platform.svc.cluster.local:5672/",
              "RABBITMQ_AI_URL": "amqp://ai:{{ .RABBITMQ_AI_PASSWORD | urlquery | replace \"+\" \"%20\" }}@rabbitmq.platform.svc.cluster.local:5672/",
              "RABBITMQ_SCORING_URL": "amqp://scoring:{{ .RABBITMQ_SCORING_PASSWORD | urlquery | replace \"+\" \"%20\" }}@rabbitmq.platform.svc.cluster.local:5672/",
              "RABBITMQ_REPORT_URL": "amqp://report:{{ .RABBITMQ_REPORT_PASSWORD | urlquery | replace \"+\" \"%20\" }}@rabbitmq.platform.svc.cluster.local:5672/"
            },
            "engineVersion": "v2",
            "mergePolicy": "Merge"
          }
        }
