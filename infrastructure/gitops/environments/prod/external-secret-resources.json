          "deletionPolicy": "Retain",
          "name": "rabbitmq-credentials",
          "template": {
            "data": {
              "RABBITMQ_URL": "amqp://{{ .RABBITMQ_USERNAME | urlquery | replace \"+\" \"%20\" }}:{{ .RABBITMQ_PASSWORD | urlquery | replace \"+\" \"%20\" }}@rabbitmq.platform.svc.cluster.local:5672/"
            },
            "engineVersion": "v2",
            "mergePolicy": "Merge"
