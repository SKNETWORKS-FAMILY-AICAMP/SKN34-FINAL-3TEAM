{
  "affinity": {
    "nodeAffinity": {
      "preferredDuringSchedulingIgnoredDuringExecution": [
        {
          "weight": 100,
          "preference": {
            "matchExpressions": [
              {
                "key": "eks.amazonaws.com/nodegroup",
                "operator": "In",
                "values": [
                  "application"
                ]
              }
            ]
          }
        }
      ]
    }
  },
  "env": [
    {
      "name": "DB_URL",
      "value": "jdbc:postgresql://sagomungchi-demo-db.czcw0ywu2euo.ap-northeast-2.rds.amazonaws.com:5432/learning_db?sslmode=verify-full&sslrootcert=/rds-ca/global-bundle.pem&connectTimeout=10"
    },
    {
      "name": "DB_USERNAME",
      "valueFrom": {
        "secretKeyRef": {
          "key": "DB_USERNAME",
          "name": "learning-db-credentials"
        }
      }
    },
    {
      "name": "DB_PASSWORD",
      "valueFrom": {
        "secretKeyRef": {
          "key": "DB_PASSWORD",
          "name": "learning-db-credentials"
        }
      }
    },
    {
      "name": "RABBITMQ_HOST",
      "value": "rabbitmq.platform.svc.cluster.local"
    },
    {
      "name": "RABBITMQ_USERNAME",
      "valueFrom": {
        "secretKeyRef": {
          "key": "RABBITMQ_USERNAME",
          "name": "rabbitmq-credentials"
        }
      }
    },
    {
      "name": "RABBITMQ_PASSWORD",
      "valueFrom": {
        "secretKeyRef": {
          "key": "RABBITMQ_PASSWORD",
          "name": "rabbitmq-credentials"
        }
      }
    },
    {
      "name": "INTERNAL_TOKEN",
      "valueFrom": {
        "secretKeyRef": {
          "key": "INTERNAL_TOKEN",
          "name": "internal-service-credentials"
        }
      }
    },
    {
      "name": "JAVA_TOOL_OPTIONS",
      "value": "-XX:MaxRAMPercentage=60.0"
    },
    {
      "name": "AI_URL",
      "value": "http://ai-service.app.svc.cluster.local:8000"
    },
    {
      "name": "CORE_URL",
      "value": "http://core-service.app.svc.cluster.local:8080"
    },
    {
      "name": "MEMORY_EMBEDDING_ENABLED",
      "value": "true"
    }
  ],
  "extraVolumeMounts": [
    {
      "mountPath": "/rds-ca",
      "name": "rds-ca",
      "readOnly": true
    }
  ],
  "extraVolumes": [
    {
      "configMap": {
        "name": "rds-ca"
      },
      "name": "rds-ca"
    }
  ],
  "hpa": {
    "enabled": true,
    "minReplicas": 1,
    "maxReplicas": 3,
    "cpuUtilization": 70
  },
  "image": {
    "digest": "sha256:deef0fc1b721f8f79446ec7d1a8e5cfe9a3e3b836854984b1854b29f23a69f61",
    "repository": "347161580747.dkr.ecr.ap-northeast-2.amazonaws.com/sagomungchi/learning-service"
  },
  "ingress": {
    "enabled": false
  },
  "javaAgent": {
    "enabled": true
  },
  "keda": {
    "enabled": false
  },
  "migration": {
    "enabled": false
  },
  "nameOverride": "learning-service",
  "networkPolicy": {
    "egress": [
      {
        "ports": [
          {
            "port": 5432,
            "protocol": "TCP"
          }
        ],
        "to": [
          {
            "ipBlock": {
              "cidr": "10.20.128.0/20"
            }
          },
          {
            "ipBlock": {
              "cidr": "10.20.144.0/20"
            }
          }
        ]
      }
    ],
    "egressToApps": [
      {
        "name": "core-service",
        "port": 8080
      },
      {
        "name": "ai-service",
        "port": 8000
      }
    ],
    "egressToPlatform": [
      {
        "name": "rabbitmq",
        "port": 5672
      }
    ],
    "enabled": true,
    "ingress": [
      {
        "from": [
          {
            "podSelector": {
              "matchLabels": {
                "deployment-check": "core-learning-health"
              }
            }
          }
        ],
        "ports": [
          {
            "port": 8081,
            "protocol": "TCP"
          }
        ]
      }
    ],
    "ingressFromApps": [
      "core-service",
      "ai-service",
      "report-api",
      "report-worker"
    ],
    "namespaceDefaultDeny": false,
    "egressToCollector": true
  },
  "pdb": {
    "enabled": false
  },
  "probes": {
    "liveness": {
      "enabled": true,
      "path": "/actuator/health/liveness",
      "periodSeconds": 10,
      "timeoutSeconds": 5
    },
    "readiness": {
      "enabled": true,
      "path": "/actuator/health/readiness",
      "periodSeconds": 10,
      "timeoutSeconds": 5
    },
    "startup": {
      "enabled": true,
      "failureThreshold": 60,
      "path": "/actuator/health/liveness",
      "periodSeconds": 10
    }
  },
  "replicaCount": 1,
  "resources": {
    "limits": {
      "cpu": "1",
      "memory": "1Gi"
    },
    "requests": {
      "cpu": "250m",
      "memory": "512Mi"
    }
  },
  "service": {
    "port": 8081,
    "targetPort": 8081
  },
  "tracing": {
    "enabled": true
  }
}
