{
  "affinity": {
    "nodeAffinity": {
      "preferredDuringSchedulingIgnoredDuringExecution": [
        {
          "weight": 100,
          "preference": {
            "matchExpressions": [
              {
                "key": "eks.amazonaws.com/nodegroup",
                "operator": "In",
                "values": [
                  "application"
                ]
              }
            ]
          }
        }
      ]
    }
  },
  "env": [
    {
      "name": "DB_URL",
      "value": "jdbc:postgresql://sagomungchi-demo-db.czcw0ywu2euo.ap-northeast-2.rds.amazonaws.com:5432/learning_db?sslmode=verify-full&sslrootcert=/rds-ca/global-bundle.pem&connectTimeout=10"
    },
    {
      "name": "DB_USERNAME",
      "valueFrom": {
        "secretKeyRef": {
          "key": "DB_USERNAME",
          "name": "learning-db-credentials"
        }
      }
    },
    {
      "name": "DB_PASSWORD",
      "valueFrom": {
        "secretKeyRef": {
          "key": "DB_PASSWORD",
          "name": "learning-db-credentials"
        }
      }
    },
    {
      "name": "RABBITMQ_HOST",
      "value": "rabbitmq.platform.svc.cluster.local"
    },
    {
      "name": "RABBITMQ_USERNAME",
      "value": "learning"
    },
    {
      "name": "RABBITMQ_PASSWORD",
      "valueFrom": {
        "secretKeyRef": {
          "key": "RABBITMQ_LEARNING_PASSWORD",
          "name": "rabbitmq-credentials"
        }
      }
    },
    {
      "name": "INTERNAL_TOKEN",
      "valueFrom": {
        "secretKeyRef": {
          "key": "INTERNAL_TOKEN_LEARNING",
          "name": "internal-service-credentials"
        }
      }
    },
    {
      "name": "INTERNAL_TOKEN_CORE",
      "valueFrom": {
        "secretKeyRef": {
          "key": "INTERNAL_TOKEN_CORE",
          "name": "internal-service-credentials"
        }
      }
    },
    {
      "name": "INTERNAL_TOKEN_AI",
      "valueFrom": {
        "secretKeyRef": {
          "key": "INTERNAL_TOKEN_AI",
          "name": "internal-service-credentials"
        }
      }
    },
    {
      "name": "INTERNAL_TOKEN_REPORT_API",
      "valueFrom": {
        "secretKeyRef": {
          "key": "INTERNAL_TOKEN_REPORT_API",
          "name": "internal-service-credentials"
        }
      }
    },
    {
      "name": "INTERNAL_TOKEN_REPORT_WORKER",
      "valueFrom": {
        "secretKeyRef": {
          "key": "INTERNAL_TOKEN_REPORT_WORKER",
          "name": "internal-service-credentials"
        }
      }
    },
    {
      "name": "JAVA_TOOL_OPTIONS",
      "value": "-XX:MaxRAMPercentage=60.0"
    },
    {
      "name": "AI_URL",
      "value": "http://ai-service.app.svc.cluster.local:8000"
    },
    {
      "name": "SCORING_URL",
      "value": "http://scoring-service.app.svc.cluster.local:8001"
    },
    {
      "name": "CORE_URL",
      "value": "http://core-service.app.svc.cluster.local:8080"
    },
    {
      "name": "MEMORY_EMBEDDING_ENABLED",
      "value": "true"
    },
    {
      "name": "MEMORY_QUERY_REWRITE_ENABLED",
      "value": "true"
    },
    {
      "name": "MEMORY_QUERY_REWRITE_TIMEOUT",
      "value": "8s"
    },
    {
      "name": "ASSET_S3_BUCKET",
      "value": "sagomungchi-demo-347161580747-missions"
    },
    {
      "name": "S3_REGION",
      "value": "ap-northeast-2"
    },
    {
      "name": "AWS_REGION",
      "value": "ap-northeast-2"
    }
  ],
  "extraVolumeMounts": [
    {
      "mountPath": "/rds-ca",
      "name": "rds-ca",
      "readOnly": true
    }
  ],
  "extraVolumes": [
    {
      "configMap": {
        "name": "rds-ca"
      },
      "name": "rds-ca"
    }
  ],
  "hpa": {
    "enabled": true,
    "minReplicas": 1,
    "maxReplicas": 3,
    "cpuUtilization": 70
  },
  "ingress": {
    "enabled": false
  },
  "javaAgent": {
    "enabled": true
  },
  "keda": {
    "enabled": false
  },
  "migration": {
    "enabled": true,
    "image": {
      "pullPolicy": "IfNotPresent"
    },
    "args": [
      "migrate"
    ],
    "env": [
      {
        "name": "FLYWAY_URL",
        "value": "jdbc:postgresql://sagomungchi-demo-db.czcw0ywu2euo.ap-northeast-2.rds.amazonaws.com:5432/learning_db?sslmode=verify-full&sslrootcert=/rds-ca/global-bundle.pem&connectTimeout=10"
      },
      {
        "name": "FLYWAY_USER",
        "valueFrom": {
          "secretKeyRef": {
            "name": "learning-migrate-credentials",
            "key": "DB_USERNAME"
          }
        }
      },
      {
        "name": "FLYWAY_PASSWORD",
        "valueFrom": {
          "secretKeyRef": {
            "name": "learning-migrate-credentials",
            "key": "DB_PASSWORD"
          }
        }
      },
      {
        "name": "FLYWAY_DEFAULT_SCHEMA",
        "value": "public"
      },
      {
        "name": "FLYWAY_CREATE_SCHEMAS",
        "value": "false"
      },
      {
        "name": "FLYWAY_BASELINE_ON_MIGRATE",
        "value": "false"
      },
      {
        "name": "FLYWAY_CLEAN_DISABLED",
        "value": "true"
      }
    ],
    "resources": {
      "requests": {
        "cpu": "100m",
        "memory": "128Mi"
      },
      "limits": {
        "memory": "512Mi"
      }
    },
    "extraVolumes": [
      {
        "name": "rds-ca",
        "configMap": {
          "name": "rds-ca"
        }
      }
    ],
    "extraVolumeMounts": [
      {
        "name": "rds-ca",
        "mountPath": "/rds-ca",
        "readOnly": true
      }
    ]
  },
  "nameOverride": "learning-service",
  "networkPolicy": {
    "egress": [
      {
        "ports": [
          {
            "port": 5432,
            "protocol": "TCP"
          }
        ],
        "to": [
          {
            "ipBlock": {
              "cidr": "10.20.128.0/20"
            }
          },
          {
            "ipBlock": {
              "cidr": "10.20.144.0/20"
            }
          }
        ]
      },
      {
        "ports": [
          {
            "port": 80,
            "protocol": "TCP"
          }
        ],
        "to": [
          {
            "ipBlock": {
              "cidr": "169.254.170.23/32"
            }
          }
        ]
      }
    ],
    "egressToApps": [
      {
        "name": "core-service",
        "port": 8080
      },
      {
        "name": "ai-service",
        "port": 8000
      },
      {
        "name": "scoring-service",
        "port": 8001
      }
    ],
    "egressToPlatform": [
      {
        "name": "rabbitmq",
        "port": 5672
      }
    ],
    "enabled": true,
    "ingress": [
      {
        "from": [
          {
            "podSelector": {
              "matchLabels": {
                "deployment-check": "core-learning-health"
              }
            }
          }
        ],
        "ports": [
          {
            "port": 8081,
            "protocol": "TCP"
          }
        ]
      }
    ],
    "ingressFromApps": [
      "core-service",
      "ai-service",
      "report-api",
      "report-worker"
    ],
    "namespaceDefaultDeny": false,
    "egressToCollector": true,
    "migrationEgress": [
      {
        "ports": [
          {
            "port": 5432,
            "protocol": "TCP"
          }
        ],
        "to": [
          {
            "ipBlock": {
              "cidr": "10.20.128.0/20"
            }
          },
          {
            "ipBlock": {
              "cidr": "10.20.144.0/20"
            }
          }
        ]
      }
    ]
  },
  "pdb": {
    "enabled": false
  },
  "probes": {
    "liveness": {
      "enabled": true,
      "path": "/actuator/health/liveness",
      "periodSeconds": 10,
      "timeoutSeconds": 5
    },
    "readiness": {
      "enabled": true,
      "path": "/actuator/health/readiness",
      "periodSeconds": 10,
      "timeoutSeconds": 5
    },
    "startup": {
      "enabled": true,
      "failureThreshold": 60,
      "path": "/actuator/health/liveness",
      "periodSeconds": 10
    }
  },
  "replicaCount": 1,
  "resources": {
    "limits": {
      "cpu": "1",
      "memory": "1Gi"
    },
    "requests": {
      "cpu": "250m",
      "memory": "512Mi"
    }
  },
  "service": {
    "port": 8081,
    "targetPort": 8081
  },
  "tracing": {
    "enabled": true
  }
}
