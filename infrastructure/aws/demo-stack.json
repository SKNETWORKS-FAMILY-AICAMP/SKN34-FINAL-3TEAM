  "rds": {
    "id": "sagomungchi-demo-db",
    "engine": "postgres",
    "version": "17.11",
    "class": "db.t4g.small",
    "multiAZ": false,
    "storageGiB": 20,
    "maxStorageGiB": 1000,
    "storageType": "gp3",
    "backupDays": 7,
    "backupWindow": "14:54-15:24",
    "maintenanceWindow": "fri:13:31-fri:14:01",
    "parameterGroup": "default.postgres17",
    "performanceInsights": true,
    "subnetGroup": {
      "name": "sagomungchi-demo-db-subnet-group",
      "description": "Private subnets for sagomungchi RDS",
      "subnets": [
        "sagomungchi-demo-subnet-private1-ap-northeast-2a",
        "sagomungchi-demo-subnet-private2-ap-northeast-2b"
      ]
    },
    "securityGroup": {
      "name": "sagomungchi-demo-rds-sg",
      "description": "PostgreSQL access from EKS nodes"
    },
    "databases": [
      "core_db",
      "learning_db",
      "report_db"
    ]
  },
  "iamRoles": [
    {
      "name": "sagomungchi-demo-eks-cluster-role",
      "trust": "iam/eks-cluster-role.trust.json",
      "managed": [
        "arn:aws:iam::aws:policy/AmazonEKSClusterPolicy"
