        "sagomungchi-demo-external-secrets-payment-read": "iam/external-secrets-role.inline.external-secrets-payment-read.json",
        "sagomungchi-demo-external-secrets-rabbitmq-read": "iam/external-secrets-role.inline.external-secrets-rabbitmq-read.json"
      }
    },
    {
      "name": "sagomungchi-demo-lb-controller-role",
      "trust": "iam/lb-controller-role.trust.json",
      "inline": {
        "AWSLoadBalancerController-v2-14-1": "iam/lb-controller-role.inline.AWSLoadBalancerController-v2-14-1.json"
      }
    },
    {
