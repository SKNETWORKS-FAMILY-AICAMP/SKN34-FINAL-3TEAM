      ]
    },
    {
      "name": "sagomungchi-demo-external-secrets-role",
      "trust": "iam/external-secrets-role.trust.json",
      "customerManaged": {
        "sagomungchi-demo-external-secrets-db-read": "iam/external-secrets-role.policy.sagomungchi-demo-external-secrets-db-read.json"
