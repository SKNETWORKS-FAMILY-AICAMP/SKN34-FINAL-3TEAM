{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListModelBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::sagomungchi-demo-347161580747-models"
    },
    {
      "Sid": "ReadToxModelsAndPublicData",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::sagomungchi-demo-347161580747-models/models/tox-*",
        "arn:aws:s3:::sagomungchi-demo-347161580747-models/datasets/tox-retrain/*"
      ]
    },
    {
      "Sid": "WriteToxModels",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::sagomungchi-demo-347161580747-models/models/tox-*"
    }
  ]
}
