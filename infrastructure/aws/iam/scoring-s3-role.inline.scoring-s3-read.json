{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListModelObjects",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::sagomungchi-demo-347161580747-models"
    },
    {
      "Sid": "ReadModelObjects",
      "Effect": "Allow",
