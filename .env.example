# 로컬 실행용 환경 변수 목록. 이 파일을 .env로 복사 후 값 입력 (.env는 커밋 금지)

# PostgreSQL 관리자: 컨테이너 초기화·관리 작업 전용. 앱·마이그레이션은 아래 서비스 계정 사용
POSTGRES_USER=sagomungchi
POSTGRES_PASSWORD=
# #230 서비스별 계정 비밀번호 (계정 이름은 core_migrate·core_app 등으로 고정)
# migrate=DDL(Flyway·Alembic), app=DML(앱 런타임). 자기 DB에만 접속 가능
# 접속 URL에 그대로 들어가므로 영문·숫자·-·_만 사용. 최초 볼륨 초기화 때만 반영 (변경 시 볼륨 재생성)
CORE_MIGRATE_PASSWORD=
CORE_APP_PASSWORD=
LEARNING_MIGRATE_PASSWORD=
LEARNING_APP_PASSWORD=
REPORT_MIGRATE_PASSWORD=
REPORT_APP_PASSWORD=

# RabbitMQ
RABBITMQ_USER=sagomungchi
RABBITMQ_PASSWORD=

# MinIO (compose.minio.yaml 선택 실행 또는 kind 배포 시 필요)
# 사용자명 3자 이상·비밀번호 8자 이상. 비밀번호에 $ 또는 #가 있으면 작은따옴표로 감싼 리터럴 사용
MINIO_ROOT_USER=sagomungchi
MINIO_ROOT_PASSWORD=

# kind 관측 배포 시에만 필요 (Grafana 관리자). 둘 다 비우면 create-app-secrets.ps1이 관측 Secret을 만들지 않음
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
# kind 운영 경보 디스코드 수신 시험에만 필요 (#187). 비워 두면 경보를 켜지 않음. URL 자체가 비밀이므로 출력·커밋 금지
# 운영(EKS)은 observability/discord-alert-webhook Secret의 DISCORD_WEBHOOK_URL을 사용 (#185)
DISCORD_WEBHOOK_URL=

# scoring: compose.minio.yaml에서 위 MinIO 자격 증명을 사용. AWS는 SDK 체인/IRSA 사용.
SCORING_S3_BUCKET=sagomungchi-local-models
SCORING_S3_REGION=ap-northeast-2
# 서술 3.0 content_3 선택 보정. 허용 기준 확정·승인 전에는 false 유지.
M2_CONTENT3_RULE_ENABLED=false

# report-service: MinIO overlay는 위 로컬 자격 증명을 사용. AWS는 SDK 자격 증명 체인/IRSA 사용.
REPORT_S3_BUCKET=sagomungchi-local-reports
REPORT_S3_REGION=ap-northeast-2
REPORT_DOWNLOAD_TTL_SECONDS=300

# 서비스 간 내부 호출 토큰 (임의의 긴 문자열)
INTERNAL_TOKEN=

# #36: base64 of at least 32 random bytes. Never reuse INTERNAL_TOKEN or commit actual values.
AUTH_JWT_SECRET=
AUTH_WEB_ORIGIN=http://localhost:5173
# #289: 서버와 웹을 함께 활성화. DB V26 적용 후 사용하며 기본은 꺼짐.
APP_GUARDIAN_TRANSFER_ENABLED=false
VITE_GUARDIAN_TRANSFER_ENABLED=false
# Local HTTP only. Keep true in HTTPS deployments.
AUTH_COOKIE_SECURE=false
# true only in the demo-only AWS environment: new Google parents are stored as is_demo.
AUTH_NEW_ACCOUNT_DEMO=false
# #517: 학부모 ID 가입은 같은 IP에서 WINDOW 동안 PER_IP회까지(초과 시 429 SIGNUP_RATE_LIMITED).
# 부하 시험처럼 한 IP에서 계정을 여러 개 만들 때만 로컬에서 늘린다.
AUTH_SIGNUP_LIMIT_PER_IP=5
AUTH_SIGNUP_LIMIT_WINDOW=10m
AUTH_ACCESS_TTL=15m
AUTH_STUDENT_ACCESS_TTL=15m
AUTH_REFRESH_TTL=7d
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Console redirect URI: http://localhost:5173/api/v1/auth/google/callback
# Google Console 재인증 redirect URI도 별도 등록: http://localhost:5173/api/v1/auth/google/reauth/callback
# AUTH_WEB_ORIGIN 변경 시 두 URI의 origin을 함께 맞춘다. 재인증 콜백은 탈퇴·보호자 비밀번호·자녀 해제 등 중요 작업용이다(학생 PIN 설정은 2026-11-10부터 재인증 없음).

# #69 판정 교차 확인: 기본 꺼짐. false면 scoring을 부르지 않고 LLM 판정만 쓴다(#305).
# true는 불일치 시 보류 적용. M1은 별도 입력 연동·품질 확인 후 활성화한다.
# 시간 단위 초. 판정 마감은 learning의 35초보다 작게, reserve는 deadline보다 작게 유지.
JUDGE_DEADLINE=33.0
SCORING_TIMEOUT=10.0
SCORING_RESERVE=3.0
M2_CROSS_CHECK_ENABLED=false
M2_NARRATIVE_LOW=2.0
M2_NARRATIVE_HIGH=4.0
M2_ESSAY_LOW=1.0
M2_ESSAY_HIGH=2.0
# M1 미지원(#501): learning이 M1 입력(answerKey·solution)을 보내지 않아 true로 켜도 M1을 부르지 않음
M1_CHECK_ENABLED=false
M1_MIN_CONFIDENCE=0.8

# LLM (ai-service). 제공자 교체는 LLM_PROVIDER만 변경, 키·모델은 제공자별로 함께 보관
# 선택한 제공자의 키를 비워 두면 LLM 호출 기능 사용 불가
LLM_PROVIDER=openai

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# (선택) 추론 강도 low|medium|high|xhigh|max, 안전 거절 시 대체 모델 사용 여부
# ANTHROPIC_EFFORT=medium
# ANTHROPIC_FALLBACK=true  # claude-haiku-5-5는 대체 모델 미지원 → false로 설정

# OpenAI 또는 OpenAI 호환 sLLM 서버 (vLLM·Ollama 등). LLM_PROVIDER=openai일 때 사용
# OpenAI인데 키가 비어 있으면 LLM 호출 기능 사용 불가 (sLLM은 키 없어도 됨)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# sLLM 서버 주소 (예: http://vllm:8000/v1). 비우면 OpenAI 기본 주소, sLLM은 키 없어도 됨
OPENAI_BASE_URL=
# (선택) JSON 출력 방식. 스키마 강제를 지원하지 않는 sLLM 서버는 json_object
# OPENAI_JSON_MODE=json_schema

# (선택) 리포트 설명 전용 sLLM 서버 (#477). LLM_PROVIDER와 별개, 비우면 설명만 503(리포트는 설명 미포함)
# 예: llama.cpp server http://localhost:8080/v1. 모델은 core 레지스트리에서 활성화해야 사용됨
# EXPLANATION_BASE_URL=
# EXPLANATION_MODEL=report-explanation

# (선택) 지식 임베딩 (#467, api-spec 4.2.4). openai는 위 OPENAI_API_KEY를 쓰고 OPENAI_BASE_URL은 쓰지 않음
# (항상 OpenAI 기본 주소). 키가 없으면 임베딩만 503. fake는 개발용 가짜 벡터(fake-bigram-v1, 외부 호출 없음)
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536

# (선택) 호스트 포트 변경. Windows에서 8000~8099가 예약된 경우 사용
# 확인: netsh int ipv4 show excludedportrange protocol=tcp
# CORE_HOST_PORT=18080
# LEARNING_HOST_PORT=18081
# AI_HOST_PORT=18000
# SCORING_HOST_PORT=18001
# REPORT_HOST_PORT=18002
# MINIO_HOST_PORT=19000
# MINIO_CONSOLE_HOST_PORT=19001

# #45 재인증: 최대 5분, 세션·작업·자녀에 결합된 1회용 토큰
AUTH_REAUTH_TTL=5m

# #58 registered devices: fixed expiry; shared Redis connection (local standalone core)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
STUDENT_DEVICE_TTL=90d
STUDENT_DEVICE_ATTEMPT_LIMIT=20

# #48: test credentials only. Obtain separate widget/billing key sets and MID from Toss.
PAYMENT_FREE_PRODUCT_ID=
TOSS_TEST_SECRET_KEY=
TOSS_TEST_BILLING_SECRET_KEY=
TOSS_TEST_MID=
TOSS_TEST_BILLING_MID=
TOSS_TEST_WEBHOOK_SECURITY_KEY=
TOSS_TEST_BILLING_WEBHOOK_SECURITY_KEY=
# Base64 of a private random 32-byte AES key, supplied by environment/Secret.
PAYMENT_BILLING_ENCRYPTION_KEY=

# TossPayments
# Public SDK key. Only this value is exposed to the browser; the secret stays on the server.
TOSSPAYMENTS_CLIENT_KEY=
# Fallback for one-time payments when TOSS_TEST_SECRET_KEY is empty. Billing uses its own key.
TOSSPAYMENTS_SECRET_KEY=
# Optional: directory containing .env when starting Vite from another worktree.
TOSSPAYMENTS_ENV_DIR=

# Billing SDK key: use the separate test_ck_ key for the billing merchant.
TOSS_TEST_BILLING_CLIENT_KEY=

# #391: #385/#391 learning을 먼저 배포. false는 새 주간 테마 요약만 생략하는 복귀 설정
REPORT_THEME_SUMMARY_ENABLED=true
# #479 explanation only: ai deadline is provisionally 125s, at most 3 answers per week.
REPORT_EXPLANATION_TIMEOUT_SECONDS=130
REPORT_EXPLANATION_BUDGET_SECONDS=400
