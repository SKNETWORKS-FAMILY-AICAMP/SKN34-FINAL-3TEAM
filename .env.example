# 로컬 실행용 환경 변수 목록. 이 파일을 .env로 복사 후 값 입력 (.env는 커밋 금지)

# PostgreSQL (core_db·learning_db·report_db 공용 계정)
POSTGRES_USER=sagomungchi
POSTGRES_PASSWORD=

# RabbitMQ
RABBITMQ_USER=sagomungchi
RABBITMQ_PASSWORD=

# 서비스 간 내부 호출 토큰 (임의의 긴 문자열)
INTERNAL_TOKEN=

# LLM (ai-service). 제공자 교체는 LLM_PROVIDER만 변경, 키·모델은 제공자별로 함께 보관
# 선택한 제공자의 키를 비워 두면 LLM 호출 기능 사용 불가
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# (선택) 추론 강도 low|medium|high|xhigh|max, 안전 거절 시 대체 모델 사용 여부
# ANTHROPIC_EFFORT=medium
# ANTHROPIC_FALLBACK=true  # claude-haiku-5-5는 대체 모델 미지원 → false로 설정

# OpenAI 또는 OpenAI 호환 sLLM 서버 (vLLM·Ollama 등). OpenAI 제공자 추가 후 사용
OPENAI_API_KEY=
OPENAI_MODEL=
# sLLM 서버 주소 (예: http://vllm:8000/v1). 비우면 OpenAI 기본 주소
OPENAI_BASE_URL=

# (선택) 호스트 포트 변경. Windows에서 8000~8099가 예약된 경우 사용
# 확인: netsh int ipv4 show excludedportrange protocol=tcp
# CORE_HOST_PORT=18080
# LEARNING_HOST_PORT=18081
# AI_HOST_PORT=18000
# SCORING_HOST_PORT=18001
# REPORT_HOST_PORT=18002
