<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sagomungchi.core.admin.repository.ConversationRetryAuditMapper">
 <insert id="insert">INSERT INTO audit_log(id,actor_user_id,action,target_type,target_id,result,detail,created_at)
 VALUES(#{id},#{row.requestedBy},#{action},'CONVERSATION',#{row.messageId},#{result},
 jsonb_build_object('retryRequestId',CAST(#{row.id} AS text),'generation',#{row.generation}),CURRENT_TIMESTAMP)</insert>
</mapper>
