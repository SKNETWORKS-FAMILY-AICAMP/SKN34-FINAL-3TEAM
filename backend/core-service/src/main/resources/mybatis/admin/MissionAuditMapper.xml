<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sagomungchi.core.admin.repository.MissionAuditMapper">
    <insert id="insert">
        INSERT INTO audit_log(id,actor_user_id,action,target_type,target_id,result,detail,created_at)
        VALUES(#{id},#{actor},#{action},'MISSION',#{target},#{result},CAST(#{detail} AS jsonb),CURRENT_TIMESTAMP)
    </insert>
</mapper>
