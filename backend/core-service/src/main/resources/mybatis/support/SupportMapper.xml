<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sagomungchi.core.support.repository.SupportMapper">
<resultMap id="report" type="com.sagomungchi.core.support.domain.SupportReport"><constructor><arg column="id" javaType="java.util.UUID"/><arg column="reporter_user_id" javaType="java.util.UUID"/><arg column="requester_role" javaType="java.lang.String"/><arg column="requester_student_id" javaType="java.util.UUID"/><arg column="student_id" javaType="java.util.UUID"/><arg column="attempt_id" javaType="java.util.UUID"/><arg column="submission_key" javaType="java.util.UUID"/><arg column="target_type" javaType="java.lang.String"/><arg column="target_id" javaType="java.util.UUID"/><arg column="category" javaType="java.lang.String"/><arg column="comment" javaType="java.lang.String"/><arg column="status" javaType="java.lang.String"/><arg column="review_result" javaType="java.lang.String"/><arg column="resolution_reason" javaType="java.lang.String"/><arg column="reviewed_by" javaType="java.util.UUID"/><arg column="created_at" javaType="java.time.OffsetDateTime"/><arg column="resolved_at" javaType="java.time.OffsetDateTime"/></constructor></resultMap>
<insert id="insertReport">INSERT INTO error_report(id,reporter_user_id,requester_role,requester_student_id,student_id,attempt_id,submission_key,target_type,target_id,category,comment,status,review_result,resolution_reason,reviewed_by,created_at,resolved_at) VALUES(#{id},#{reporterUserId},#{requesterRole},#{requesterStudentId},#{studentId},#{attemptId},#{submissionKey},#{targetType},#{targetId},#{category},#{comment},#{status},#{reviewResult},#{resolutionReason},#{reviewedBy},#{createdAt},#{resolvedAt})</insert>
<select id="report" resultMap="report">SELECT * FROM error_report WHERE id=#{id}</select>
<select id="lockReport" resultMap="report">SELECT * FROM error_report WHERE id=#{id} FOR UPDATE</select>
<sql id="reportFilter"><where>
  <if test="user != null">reporter_user_id=#{user} AND requester_role=#{role} AND requester_student_id IS NOT DISTINCT FROM #{student}
 AND (student_id IS NULL <if test="!scope.isEmpty()">OR student_id IN <foreach collection="scope" item="allowed" open="(" close=")" separator=",">#{allowed}</foreach></if>)</if>
  <if test="status != null">AND status=#{status}</if></where></sql>
  <select id="reports" resultMap="report">SELECT * FROM error_report<include refid="reportFilter"/> ORDER BY created_at DESC,id DESC LIMIT #{limit} OFFSET #{offset}</select>
  <select id="reportCount" resultType="long">SELECT count(*) FROM error_report<include refid="reportFilter"/></select>
<resultMap id="inquiry" type="com.sagomungchi.core.support.domain.Inquiry"><constructor><arg column="id" javaType="java.util.UUID"/><arg column="user_id" javaType="java.util.UUID"/><arg column="requester_role" javaType="java.lang.String"/><arg column="requester_student_id" javaType="java.util.UUID"/><arg column="student_id" javaType="java.util.UUID"/><arg column="attempt_id" javaType="java.util.UUID"/><arg column="category" javaType="java.lang.String"/><arg column="title" javaType="java.lang.String"/><arg column="body" javaType="java.lang.String"/><arg column="status" javaType="java.lang.String"/><arg column="answer" javaType="java.lang.String"/><arg column="answered_by" javaType="java.util.UUID"/><arg column="answered_at" javaType="java.time.OffsetDateTime"/><arg column="created_at" javaType="java.time.OffsetDateTime"/></constructor></resultMap>
<insert id="insertInquiry">INSERT INTO inquiry(id,user_id,requester_role,requester_student_id,student_id,attempt_id,category,title,body,status,answer,answered_by,answered_at,created_at) VALUES(#{id},#{userId},#{requesterRole},#{requesterStudentId},#{studentId},#{attemptId},#{category},#{title},#{body},#{status},#{answer},#{answeredBy},#{answeredAt},#{createdAt})</insert>
<select id="inquiry" resultMap="inquiry">SELECT * FROM inquiry WHERE id=#{id}</select>
<select id="lockInquiry" resultMap="inquiry">SELECT * FROM inquiry WHERE id=#{id} FOR UPDATE</select>
<sql id="inquiryFilter"><where>
  <if test="user != null">user_id=#{user} AND requester_role=#{role} AND requester_student_id IS NOT DISTINCT FROM #{student}
 AND (student_id IS NULL <if test="!scope.isEmpty()">OR student_id IN <foreach collection="scope" item="allowed" open="(" close=")" separator=",">#{allowed}</foreach></if>)</if>
  <if test="status != null">AND status=#{status}</if></where></sql>
  <select id="inquiries" resultMap="inquiry">SELECT * FROM inquiry<include refid="inquiryFilter"/> ORDER BY created_at DESC,id DESC LIMIT #{limit} OFFSET #{offset}</select>
  <select id="inquiryCount" resultType="long">SELECT count(*) FROM inquiry<include refid="inquiryFilter"/></select>
<resultMap id="correction" type="com.sagomungchi.core.support.domain.Correction"><constructor><arg column="id" javaType="java.util.UUID"/><arg column="error_report_id" javaType="java.util.UUID"/><arg column="target_type" javaType="java.lang.String"/><arg column="target_id" javaType="java.util.UUID"/><arg column="request_key" javaType="java.util.UUID"/><arg column="reason" javaType="java.lang.String"/><arg column="corrected" javaType="java.lang.String"/><arg column="previous_result" javaType="java.lang.String"/><arg column="processing_status" javaType="java.lang.String"/><arg column="impact" javaType="java.lang.String"/><arg column="provider_result" javaType="java.lang.String"/><arg column="corrected_by" javaType="java.util.UUID"/><arg column="created_at" javaType="java.time.OffsetDateTime"/><arg column="completed_at" javaType="java.time.OffsetDateTime"/></constructor></resultMap>
<insert id="insertCorrection">INSERT INTO correction(id,error_report_id,target_type,target_id,request_key,reason,corrected,previous_result,processing_status,impact,provider_result,corrected_by,created_at,completed_at) VALUES(#{id},#{errorReportId},#{targetType},#{targetId},#{requestKey},#{reason},#{corrected},#{previousResult},#{processingStatus},CAST(#{impact} AS jsonb),CAST(#{providerResult} AS jsonb),#{correctedBy},#{createdAt},#{completedAt})</insert>
<resultMap id="notice" type="com.sagomungchi.core.support.domain.Notice"><constructor><arg column="id" javaType="java.util.UUID"/><arg column="kind" javaType="java.lang.String"/><arg column="title" javaType="java.lang.String"/><arg column="body" javaType="java.lang.String"/><arg column="target_roles" javaType="java.lang.String"/><arg column="visible_from" javaType="java.time.OffsetDateTime"/><arg column="visible_to" javaType="java.time.OffsetDateTime"/><arg column="created_by" javaType="java.util.UUID"/><arg column="created_at" javaType="java.time.OffsetDateTime"/><arg column="ended_at" javaType="java.time.OffsetDateTime"/></constructor></resultMap>
<insert id="insertNotice">INSERT INTO notice(id,kind,title,body,target_roles,visible_from,visible_to,created_by,created_at,ended_at) VALUES(#{id},#{kind},#{title},#{body},CAST(#{targetRoles} AS jsonb),#{visibleFrom},#{visibleTo},#{createdBy},#{createdAt},#{endedAt})</insert>
<select id="submission" resultMap="report">SELECT * FROM error_report WHERE reporter_user_id=#{user} AND submission_key=#{key}</select>
<update id="updateReport">UPDATE error_report SET status=#{status},review_result=#{reviewResult},resolution_reason=#{resolutionReason},reviewed_by=#{reviewedBy},resolved_at=#{resolvedAt} WHERE id=#{id}</update>
<update id="updateInquiry">UPDATE inquiry SET status=#{status},answer=#{answer},answered_by=#{answeredBy},answered_at=#{answeredAt} WHERE id=#{id}</update>
<select id="correction" resultMap="correction">SELECT * FROM correction WHERE error_report_id=#{reportId} AND request_key IS NOT NULL</select>
<select id="corrections" resultMap="correction">SELECT * FROM correction WHERE error_report_id=#{reportId} ORDER BY created_at,id</select>
<update id="updateCorrection">UPDATE correction SET processing_status=#{processingStatus},impact=CAST(#{impact} AS jsonb),provider_result=CAST(#{providerResult} AS jsonb),completed_at=#{completedAt} WHERE id=#{id}</update>
<sql id="visible">ended_at IS NULL AND visible_from &lt;= CURRENT_TIMESTAMP AND (visible_to IS NULL OR visible_to &gt; CURRENT_TIMESTAMP) AND target_roles @&gt; jsonb_build_array(CAST(#{role} AS text))</sql>
<select id="notices" resultMap="notice">SELECT * FROM notice WHERE <include refid="visible"/> ORDER BY visible_from DESC,id DESC LIMIT #{limit} OFFSET #{offset}</select>
<select id="noticeCount" resultType="long">SELECT count(*) FROM notice WHERE <include refid="visible"/></select>
<select id="lockNotice" resultMap="notice">SELECT * FROM notice WHERE id=#{id} FOR UPDATE</select>
<update id="updateNotice">UPDATE notice SET kind=#{kind},title=#{title},body=#{body},target_roles=CAST(#{targetRoles} AS jsonb),visible_from=#{visibleFrom},visible_to=#{visibleTo},ended_at=#{endedAt} WHERE id=#{id}</update>
<insert id="audit">INSERT INTO audit_log(id,actor_user_id,action,target_type,target_id,result,detail,created_at) VALUES(#{id},#{actor},#{action},#{type},#{target},'SUCCESS',CAST(#{detail} AS jsonb),CURRENT_TIMESTAMP)</insert>
</mapper>
