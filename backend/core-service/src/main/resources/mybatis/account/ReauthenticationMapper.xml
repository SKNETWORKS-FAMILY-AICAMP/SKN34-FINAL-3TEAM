<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sagomungchi.core.account.repository.ReauthenticationMapper">
<resultMap id="challenge" type="com.sagomungchi.core.account.domain.ReauthChallenge"><constructor><arg column="id" javaType="java.util.UUID"/><arg column="user_id" javaType="java.util.UUID"/><arg column="session_id" javaType="java.util.UUID"/><arg column="session_version" javaType="_long"/><arg column="purpose" javaType="java.lang.String"/><arg column="student_id" javaType="java.util.UUID"/><arg column="scope" javaType="java.lang.String"/><arg column="state_hash" javaType="java.lang.String"/><arg column="expires_at" javaType="java.time.OffsetDateTime"/><arg column="verified_at" javaType="java.time.OffsetDateTime"/><arg column="issued_at" javaType="java.time.OffsetDateTime"/></constructor></resultMap><resultMap id="grant" type="com.sagomungchi.core.account.domain.ReauthGrant"><constructor><arg column="token_hash" javaType="java.lang.String"/><arg column="challenge_id" javaType="java.util.UUID"/><arg column="expires_at" javaType="java.time.OffsetDateTime"/><arg column="used_at" javaType="java.time.OffsetDateTime"/></constructor></resultMap>
 <insert id="insert">INSERT INTO reauth_challenge(id,user_id,session_id,session_version,purpose,student_id,scope,state_hash,expires_at)
 VALUES(#{id},#{userId},#{sessionId},#{sessionVersion},#{purpose},#{studentId,jdbcType=OTHER},#{scope,jdbcType=VARCHAR},#{stateHash},#{expiresAt})</insert>
 <select id="find" resultMap="challenge" flushCache="true" useCache="false">SELECT * FROM reauth_challenge WHERE id=#{id}<if test="lock"> FOR UPDATE</if></select>
 <update id="verify">UPDATE reauth_challenge SET verified_at=#{now} WHERE id=#{id} AND verified_at IS NULL AND issued_at IS NULL</update>
 <update id="issue">UPDATE reauth_challenge SET issued_at=#{now} WHERE id=#{id} AND issued_at IS NULL AND verified_at IS NOT NULL</update>
 <insert id="insertGrant">INSERT INTO reauth_grant(token_hash,challenge_id,expires_at) VALUES(#{tokenHash},#{challengeId},#{expiresAt})</insert>
 <select id="grant" resultMap="grant" flushCache="true" useCache="false">SELECT * FROM reauth_grant WHERE token_hash=#{hash} FOR UPDATE</select>
 <update id="consume">UPDATE reauth_grant SET used_at=#{now} WHERE token_hash=#{hash} AND used_at IS NULL AND expires_at &gt; #{now}</update>

</mapper>
