<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sagomungchi.core.account.repository.GuardianPasswordMapper">
  <resultMap id="password" type="com.sagomungchi.core.account.domain.GuardianPassword">
    <constructor>
      <idArg column="user_id" javaType="java.util.UUID"/>
      <arg column="password_hash" javaType="java.lang.String"/>
      <arg column="failed_count" javaType="_int"/>
      <arg column="locked_at" javaType="java.time.OffsetDateTime"/>
      <arg column="updated_at" javaType="java.time.OffsetDateTime"/>
    </constructor>
  </resultMap>
  <select id="find" resultMap="password" useCache="false" flushCache="true">
    SELECT user_id,password_hash,failed_count,locked_at,updated_at FROM guardian_password WHERE user_id=#{user}
    <if test="lock">FOR UPDATE</if>
  </select>
  <!-- Setting a new password also clears the failure counter and lock. -->
  <insert id="set">
    INSERT INTO guardian_password(user_id,password_hash,failed_count,locked_at,updated_at) VALUES(#{user},#{hash},0,NULL,#{now})
    ON CONFLICT (user_id) DO UPDATE SET password_hash=EXCLUDED.password_hash,failed_count=0,locked_at=NULL,updated_at=EXCLUDED.updated_at
  </insert>
  <update id="attempt">UPDATE guardian_password SET failed_count=#{count},locked_at=#{lockedAt,jdbcType=TIMESTAMP_WITH_TIMEZONE} WHERE user_id=#{user}</update>
  <delete id="clear">DELETE FROM guardian_password WHERE user_id=#{user}</delete>
</mapper>
