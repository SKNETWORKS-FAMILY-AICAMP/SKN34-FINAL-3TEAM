<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sagomungchi.core.usage.repository.MemoryDailyUsageRepository">
 <select id="lock" resultType="string" flushCache="true" useCache="false">SELECT pg_advisory_xact_lock(hashtextextended('memory-usage:' || CAST(#{student} AS text) || ':' || #{kind},0))::text</select>
 <insert id="insert">INSERT INTO memory_daily_usage(id,student_id,kind,usage_date,created_at) VALUES(#{id},#{student},#{kind},#{date},now())</insert>
 <select id="count" resultType="int" flushCache="true" useCache="false">SELECT count(*) FROM memory_daily_usage WHERE student_id=#{student} AND kind=#{kind} AND usage_date=#{date}</select>
 <delete id="delete">DELETE FROM memory_daily_usage WHERE id=#{id}</delete>
 <delete id="deleteStudent">DELETE FROM memory_daily_usage WHERE student_id=#{student}</delete>
</mapper>
