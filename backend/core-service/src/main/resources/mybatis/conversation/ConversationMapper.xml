<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sagomungchi.core.conversation.repository.ConversationMapper">
<resultMap id="conversation" type="com.sagomungchi.core.conversation.domain.ConversationRow"><constructor>
<arg column="id" javaType="java.util.UUID"/>
<arg column="parent_user_id" javaType="java.util.UUID"/>
<arg column="student_id" javaType="java.util.UUID"/>
<arg column="period_from" javaType="java.time.LocalDate"/>
<arg column="period_to" javaType="java.time.LocalDate"/>
<arg column="created_at" javaType="java.time.OffsetDateTime"/>
<arg column="updated_at" javaType="java.time.OffsetDateTime"/>
</constructor></resultMap>
<resultMap id="message" type="com.sagomungchi.core.conversation.domain.MessageRow"><constructor>
<arg column="id" javaType="java.util.UUID"/>
<arg column="conversation_id" javaType="java.util.UUID"/>
<arg column="seq" javaType="_int"/>
<arg column="question" javaType="java.lang.String"/>
<arg column="answer" javaType="java.lang.String"/>
<arg column="scope_student_id" javaType="java.util.UUID"/>
<arg column="scope_from" javaType="java.time.LocalDate"/>
<arg column="scope_to" javaType="java.time.LocalDate"/>
<arg column="scope_changed" javaType="_boolean"/>
<arg column="status" javaType="java.lang.String"/>
<arg column="source" javaType="java.lang.String"/>
<arg column="clarification" javaType="java.lang.String"/>
<arg column="metrics" javaType="java.lang.String"/>
<arg column="verification" javaType="java.lang.String"/>
<arg column="record_count" javaType="java.lang.Integer"/>
<arg column="failure_code" javaType="java.lang.String"/>
<arg column="retry_count" javaType="_int"/>
<arg column="created_at" javaType="java.time.OffsetDateTime"/>
<arg column="completed_at" javaType="java.time.OffsetDateTime"/>
</constructor></resultMap>
<resultMap id="evidence" type="com.sagomungchi.core.conversation.domain.EvidenceRow"><constructor>
<arg column="id" javaType="java.util.UUID"/>
<arg column="message_id" javaType="java.util.UUID"/>
<arg column="attempt_id" javaType="java.util.UUID"/>
<arg column="answer_id" javaType="java.util.UUID"/>
<arg column="answer_version" javaType="_int"/>
</constructor></resultMap>

<select id="find" resultMap="conversation" flushCache="true" useCache="false">SELECT * FROM conversation WHERE id=#{id}</select>
<select id="lock" resultMap="conversation" flushCache="true" useCache="false">SELECT * FROM conversation WHERE id=#{id} FOR UPDATE</select>
<select id="lockStudent" resultType="java.util.UUID" flushCache="true" useCache="false">SELECT id FROM student WHERE id=#{id} AND status='ACTIVE' FOR UPDATE</select>
<select id="list" resultMap="conversation" flushCache="true" useCache="false">SELECT * FROM conversation WHERE parent_user_id=#{parent} AND student_id=#{student} ORDER BY created_at DESC,id LIMIT 100</select>
<insert id="insert">INSERT INTO conversation(id,parent_user_id,student_id,period_from,period_to,created_at,updated_at) VALUES(#{id},#{parentUserId},#{studentId},#{periodFrom},#{periodTo},#{createdAt},#{updatedAt})</insert>
<update id="scope">UPDATE conversation SET period_from=#{scope.from},period_to=#{scope.to},updated_at=#{now} WHERE id=#{id}</update>
<select id="messages" resultMap="message" flushCache="true" useCache="false">SELECT * FROM conversation_message WHERE conversation_id=#{id} ORDER BY seq</select>
<select id="message" resultMap="message" flushCache="true" useCache="false">SELECT * FROM conversation_message WHERE id=#{id}</select>
<insert id="insertMessage">INSERT INTO conversation_message(id,conversation_id,seq,question,scope_student_id,scope_from,scope_to,scope_changed,status,retry_count,created_at) VALUES(#{id},#{conversationId},#{seq},#{question},#{scopeStudentId},#{scopeFrom},#{scopeTo},#{scopeChanged},'RUNNING',#{retryCount},#{createdAt})</insert>
<update id="retry">UPDATE conversation_message SET status='RUNNING',retry_count=retry_count+1,failure_code=NULL,completed_at=NULL WHERE id=#{id} AND status='FAILED' AND retry_count=#{generation}</update>
<update id="finish">UPDATE conversation_message SET status='COMPLETED',answer=#{row.answer},source=#{row.source},clarification=CAST(#{row.clarification,jdbcType=VARCHAR} AS jsonb),metrics=CAST(#{row.metrics,jdbcType=VARCHAR} AS jsonb),verification=CAST(#{row.verification,jdbcType=VARCHAR} AS jsonb),record_count=#{row.recordCount},failure_code=#{row.failureCode},completed_at=#{row.completedAt} WHERE id=#{row.id} AND status='RUNNING' AND retry_count=#{generation}</update>
<update id="fail">UPDATE conversation_message SET status='FAILED',failure_code=#{code},completed_at=#{now} WHERE id=#{id} AND status='RUNNING' AND retry_count=#{generation}</update>
<select id="evidence" resultMap="evidence" flushCache="true" useCache="false">SELECT * FROM message_evidence WHERE message_id=#{id} ORDER BY id</select>
<insert id="insertEvidence">INSERT INTO message_evidence(id,message_id,attempt_id,answer_id,answer_version) VALUES(#{id},#{messageId},#{attemptId},#{answerId},#{answerVersion})</insert>
</mapper>
