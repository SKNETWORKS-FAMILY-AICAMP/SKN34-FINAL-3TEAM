<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sagomungchi.learning.knowledge.repository.KnowledgeQueryMapper">
    <resultMap id="dataset" type="com.sagomungchi.learning.knowledge.repository.KnowledgeDatasetRow">
        <constructor>
            <arg column="version" javaType="java.lang.String"/>
        </constructor>
    </resultMap>
    <resultMap id="chunk" type="com.sagomungchi.learning.knowledge.repository.KnowledgeChunkRow">
        <constructor>
            <idArg column="id" javaType="java.lang.String"/>
            <arg column="kind" javaType="java.lang.String"/>
            <arg column="subject" javaType="java.lang.String"/>
            <arg column="area" javaType="java.lang.String"/>
            <arg column="standard_code" javaType="java.lang.String"/>
            <arg column="domain_id" javaType="java.lang.String"/>
            <arg column="thinking_type" javaType="java.lang.String"/>
            <arg column="grades" javaType="com.fasterxml.jackson.databind.JsonNode"/>
            <arg column="semesters" javaType="com.fasterxml.jackson.databind.JsonNode"/>
            <arg column="notice_grade_band" javaType="java.lang.String"/>
            <arg column="text" javaType="java.lang.String"/>
            <arg column="record" javaType="com.fasterxml.jackson.databind.JsonNode"/>
        </constructor>
    </resultMap>
    <sql id="chunkColumns">
        c.id, c.kind, c.subject, c.area, c.standard_code, c.domain_id, c.thinking_type,
        to_jsonb(c.grades) AS grades, to_jsonb(c.semesters) AS semesters,
        c.notice_grade_band, c.text, c.record
    </sql>

    <!-- Transaction-local deadline, bound as data. It never changes another request's connection settings. -->
    <select id="setLocalTimeout" resultType="string" timeout="2">
        SELECT set_config('statement_timeout', #{milliseconds}, true)
    </select>
    <select id="findActiveDataset" resultMap="dataset" timeout="2">
        SELECT version FROM knowledge_dataset WHERE status = 'ACTIVE'
    </select>
    <select id="findChunks" resultMap="chunk" timeout="2">
        SELECT <include refid="chunkColumns"/>
        FROM knowledge_chunk c WHERE c.dataset_version = #{version} AND c.kind = #{kind} AND c.id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
        ORDER BY c.id
    </select>
    <select id="findSubjectGuides" resultMap="chunk" timeout="2">
        SELECT <include refid="chunkColumns"/>
        FROM knowledge_chunk c WHERE c.dataset_version = #{version} AND c.kind = 'SUBJECT_GUIDE' AND c.subject IN
        <foreach collection="subjects" item="subject" open="(" separator="," close=")">#{subject}</foreach>
        ORDER BY c.subject, c.id
    </select>
    <select id="findCovers" resultType="com.sagomungchi.learning.knowledge.repository.KnowledgeCoverRow" timeout="2">
        SELECT standard_code, content_id FROM knowledge_covers
        WHERE dataset_version = #{version} AND reviewed_at IS NOT NULL
          AND btrim(reviewed_by) NOT IN ('', 'SAMPLE') AND standard_code IN
        <foreach collection="codes" item="code" open="(" separator="," close=")">#{code}</foreach>
        ORDER BY standard_code, content_id
    </select>
    <select id="findFits" resultType="com.sagomungchi.learning.knowledge.repository.KnowledgeFitRow" timeout="2">
        SELECT standard_code, thinking_type, reason FROM knowledge_fits
        WHERE dataset_version = #{version} AND reviewed_at IS NOT NULL
          AND btrim(reviewed_by) NOT IN ('', 'SAMPLE') AND standard_code IN
        <foreach collection="codes" item="code" open="(" separator="," close=")">#{code}</foreach>
        ORDER BY standard_code, thinking_type
    </select>
</mapper>
